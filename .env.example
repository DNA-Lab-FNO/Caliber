# ==============================================================================
# Caliber Production Environment Configuration
# Copy this file to .env and customize the values before running docker compose
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Security & Core Settings
# ------------------------------------------------------------------------------
# Set to False in production
DEBUG=False

# Django SECRET_KEY: generate a new random key using:
# python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=change-this-to-a-secure-random-50-character-secret-key

# Comma-separated list of hostnames/IPs the application is accessible on
# Example: ALLOWED_HOSTS=caliber.example.com,203.0.113.10
ALLOWED_HOSTS=caliber.example.com,localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF protection (must include protocol)
# Example: CSRF_TRUSTED_ORIGINS=https://caliber.example.com
CSRF_TRUSTED_ORIGINS=https://caliber.example.com

# Enable SSL proxy header processing when behind a reverse proxy (Caddy, Nginx, etc.)
USE_X_FORWARDED_PROTO=True

# Application logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Database connection lifetime in seconds (0 to close after each request)
CONN_MAX_AGE=60

# Definition of the default superuser credentials for Django admin creation
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=AdminPassword123!

# Enable account approval workflow for new user registrations (True/False)
REQUIRE_ACCOUNT_APPROVAL=True

# Django application URL prefix (if the app is served under a subpath)
#FORCE_SCRIPT_NAME= /caliber
#STATIC_URL=  /caliber/static/

# ------------------------------------------------------------------------------
# PostgreSQL Database Credentials
# ------------------------------------------------------------------------------
POSTGRES_DB=caliber_db
POSTGRES_USER=caliber_user
POSTGRES_PASSWORD=please_generate_a_strong_database_password_here
